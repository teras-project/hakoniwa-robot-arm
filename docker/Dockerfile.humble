FROM ros:humble-ros-base-jammy

ARG DEBIAN_FRONTEND=noninteractive
ENV CMAKE_BUILD_PARALLEL_LEVEL=2 \
    PYTHONUNBUFFERED=1

# Development dependencies only. Project sources and workspaces are mounted.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git ninja-build patch pkg-config ruby unzip \
        libboost-dev libgl1-mesa-dev libglfw3-dev \
        libx11-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev \
        python-is-python3 python3-dev python3-pip python3-venv \
        python3-colcon-common-extensions \
        ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-trajectory-msgs \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3.12 python3.12-dev python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Keep ROS on Ubuntu's Python 3.10. Foundation selects python3.12 explicitly.
# Jammy's CMake is older than the policies used by Core; expose only the CMake
# tools from this venv, never its Python interpreter, on the system PATH.
RUN python3 -m venv /opt/cmake-tools \
    && /opt/cmake-tools/bin/python -m pip install --no-cache-dir 'cmake>=3.27,<4' \
    && ln -s /opt/cmake-tools/bin/cmake /usr/local/bin/cmake \
    && ln -s /opt/cmake-tools/bin/ctest /usr/local/bin/ctest \
    && ln -s /opt/cmake-tools/bin/cpack /usr/local/bin/cpack \
    && python3.12 -c 'import sys; assert sys.version_info[:2] == (3, 12)' \
    && cmake --version

WORKDIR /workspace
# Retain the official ROS entrypoint; no project environment is activated here.
CMD ["bash"]
