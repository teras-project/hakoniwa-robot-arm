<?xml version="1.0"?>
<package format="3">
  <name>hakoniwa_dobot</name><version>0.1.0</version>
  <description>Dobot official ROS API compatible virtual robot wiring.</description>
  <maintainer email="tmori@hakoniwa-lab.net">Hakoniwa contributors</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>dobot_msgs_v4</exec_depend><exec_depend>dobot_bringup_v4</exec_depend>
  <exec_depend>hakoniwa_pdu_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
