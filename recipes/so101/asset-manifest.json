  "runtime_config": "config/runtime.json",
  "components": [
    { "id": "shoulder_pan", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/shoulder_pan.json", "pdu_robot": "SO101" },
    { "id": "shoulder_lift", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/shoulder_lift.json", "pdu_robot": "SO101" },
    { "id": "elbow_flex", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/elbow_flex.json", "pdu_robot": "SO101" },
    { "id": "wrist_flex", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/wrist_flex.json", "pdu_robot": "SO101" },
