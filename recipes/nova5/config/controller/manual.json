{
  "$schema": "https://hakoniwa.dev/schemas/robot-arm-joy-manual-controller.schema.json",
  "schema_version": 1,
  "id": "nova5-manual-jog-v1",
  "joy_layout": "../../../../profiles/gamepads/logical-joy-v1.json",
  "input": {
    "pdu_name": "joy",
    "message_type": "sensor_msgs/Joy",
    "update_rate_hz": 20.0,
    "timeout_sec": 0.25
  },
  "spec": {
    "manual_enable_button": "l1",
    "quit_button": "options",
    "deadzone": 0.10,
    "expo": 0.35,
    "banks": [
      {
        "id": "base-shoulder",
        "select_button": null,
        "bindings": [
          { "axis": "right_x", "joint": "joint1", "velocity_rad_s": 0.50 },
          { "axis": "right_y", "joint": "joint2", "velocity_rad_s": 0.35 }
        ]
      },
      {
        "id": "elbow-wrist1",
        "select_button": "r1",
        "bindings": [
          { "axis": "right_y", "joint": "joint3", "velocity_rad_s": 0.35 },
          { "axis": "right_x", "joint": "joint4", "velocity_rad_s": 0.60 }
        ]
      },
      {
        "id": "wrist2-wrist3",
        "select_button": "triangle",
        "bindings": [
          { "axis": "left_y", "joint": "joint5", "velocity_rad_s": 0.50 },
          { "axis": "left_x", "joint": "joint6", "velocity_rad_s": 0.60 }
        ]
      }
    ]
  }
}
