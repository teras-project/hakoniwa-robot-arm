  "components": [
    { "id": "j1", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/j1.json", "pdu_robot": "FR5" },
    { "id": "j2", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/j2.json", "pdu_robot": "FR5" },
    { "id": "j3", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/j3.json", "pdu_robot": "FR5" },
    { "id": "j4", "kind": "actuator", "type": "joint_position_actuator", "config": "config/actuator/joint/j4.json", "pdu_robot": "FR5" },
